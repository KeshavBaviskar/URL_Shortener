<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>URL Shortener</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: '#3b82f6',
              secondary: '#8b5cf6',
            }
          }
        }
      }
    </script>
  </head>
  <body class="bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50 min-h-screen">
    <div class="container mx-auto px-4 py-6 sm:py-8 max-w-7xl">
      <!-- Header -->
      <header class="bg-white rounded-xl shadow-lg p-4 sm:p-6 mb-6 sm:mb-8">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div class="flex items-center gap-3">
            <div class="bg-gradient-to-r from-blue-600 to-purple-600 p-2 sm:p-3 rounded-lg">
              <svg class="w-6 h-6 sm:w-8 sm:h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
              </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
              URL Shortener
            </h1>
          </div>
          <% if (locals.user) { %>
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-4 w-full sm:w-auto">
            <div class="text-sm text-gray-600">
              <span class="font-semibold">Welcome,</span> 
              <span class="text-blue-600 font-medium"><%= locals.user.email %></span>
            </div>
            <form method="get" action="/user/logout" class="w-full sm:w-auto">
              <button type="submit" class="w-full sm:w-auto bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition duration-200 font-medium shadow-md hover:shadow-lg">
                Logout
              </button>
            </form>
          </div>
          <% } %>
        </div>
      </header>

      <!-- Error Message -->
      <% if (locals.error) { %>
      <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-lg shadow-sm animate-pulse">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
          </svg>
          <p class="font-medium"><%= locals.error %></p>
        </div>
      </div>
      <% } %>

      <!-- Success Message -->
      <% if (locals.success) { %>
      <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded-lg shadow-sm">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <p class="font-medium"><%= locals.success %></p>
        </div>
      </div>
      <% } %>

      <!-- URL Shortener Form -->
      <div class="bg-white rounded-xl shadow-lg p-6 sm:p-8 mb-6 sm:mb-8">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-800 mb-4 sm:mb-6">Create Short URL</h2>
        <form method="POST" action="/url" class="space-y-4" id="urlForm">
          <div>
            <label for="url" class="block text-sm font-medium text-gray-700 mb-2">
              Enter Your Original URL
            </label>
            <div class="flex flex-col sm:flex-row gap-3">
              <input 
                type="text" 
                id="url"
                name="url" 
                placeholder="example.com or https://example.com" 
                required
                class="flex-1 px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition duration-200 text-base"
              />
              <button 
                type="submit" 
                class="bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white px-6 py-3 rounded-lg font-semibold transition duration-200 shadow-md hover:shadow-lg transform hover:scale-105 text-base"
              >
                Generate Short URL
              </button>
            </div>
            <p class="mt-2 text-xs text-gray-500">You can enter URLs with or without https://</p>
          </div>
        </form>
      </div>

      <!-- URLs Table -->
      <% if (locals.urls && urls.length > 0) { %>
      <div class="bg-white rounded-xl shadow-lg p-4 sm:p-6 overflow-hidden">
        <div class="flex items-center justify-between mb-4 sm:mb-6">
          <h2 class="text-xl sm:text-2xl font-bold text-gray-800">Your Shortened URLs</h2>
          <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-3 py-1 rounded-full">
            <%= urls.length %> <%= urls.length === 1 ? 'URL' : 'URLs' %>
          </span>
        </div>
        <div class="overflow-x-auto -mx-4 sm:mx-0">
          <div class="inline-block min-w-full align-middle">
            <div class="overflow-hidden">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">#</th>
                    <th class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Short URL</th>
                    <th class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden lg:table-cell">Original URL</th>
                    <th class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Clicks</th>
                    <th class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <% urls.forEach((url, index) => { %>
                  <tr class="hover:bg-gray-50 transition duration-150">
                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                      <%= index + 1 %>
                    </td>
                    <td class="px-3 sm:px-6 py-4">
                      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-2">
                        <a 
                          href="<%= `${locals.baseUrl}/url/${url.shortId}` %>" 
                          target="_blank"
                          class="text-blue-600 hover:text-blue-800 font-medium text-sm break-all sm:break-normal"
                        >
                          <%= `${locals.baseUrl}/url/${url.shortId}` %>
                        </a>
                        <button 
                          onclick="copyToClipboard('<%= `${locals.baseUrl}/url/${url.shortId}` %>', this)"
                          class="text-gray-500 hover:text-blue-600 transition duration-200 p-1 rounded hover:bg-blue-50"
                          title="Copy to clipboard"
                        >
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                          </svg>
                        </button>
                      </div>
                    </td>
                    <td class="px-3 sm:px-6 py-4 text-sm text-gray-500 hidden lg:table-cell">
                      <div class="max-w-xs truncate" title="<%= url.redirectURL %>">
                        <%= url.redirectURL %>
                      </div>
                    </td>
                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap">
                      <span 
                        data-short-id="<%= url.shortId %>" 
                        data-click-count="<%= url.visitHistory.length %>"
                        class="click-count px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800"
                      >
                        <%= url.visitHistory.length %> <%= url.visitHistory.length === 1 ? 'click' : 'clicks' %>
                      </span>
                    </td>
                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-sm">
                      <div class="flex flex-col sm:flex-row gap-2">
                        <a 
                          href="<%= `${locals.baseUrl}/url/${url.shortId}` %>" 
                          target="_blank"
                          class="text-blue-600 hover:text-blue-800 font-medium hover:underline"
                        >
                          Open
                        </a>
                        <button 
                          onclick="deleteURL('<%= url.shortId %>', this)"
                          class="text-red-600 hover:text-red-800 font-medium hover:underline"
                        >
                          Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
      <% } else { %>
      <div class="bg-white rounded-xl shadow-lg p-12 text-center">
        <svg class="mx-auto h-16 w-16 sm:h-20 sm:w-20 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
        </svg>
        <h3 class="text-xl font-semibold text-gray-700 mb-2">No URLs yet</h3>
        <p class="text-gray-500 mb-6">Create your first short URL using the form above!</p>
        <div class="inline-block bg-blue-100 text-blue-800 px-4 py-2 rounded-lg text-sm font-medium">
          Get started by shortening your first URL
        </div>
      </div>
      <% } %>
    </div>

    <script>
      function copyToClipboard(text, button) {
        navigator.clipboard.writeText(text).then(() => {
          const originalHTML = button.innerHTML;
          button.innerHTML = '<svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
          button.classList.add('text-green-600');
          button.classList.remove('text-gray-500');
          setTimeout(() => {
            button.innerHTML = originalHTML;
            button.classList.remove('text-green-600');
            button.classList.add('text-gray-500');
          }, 2000);
        }).catch(err => {
          console.error('Failed to copy:', err);
          alert('Failed to copy to clipboard');
        });
      }

      async function deleteURL(shortId, button) {
        if (!confirm('Are you sure you want to delete this URL?')) {
          return;
        }

        const row = button.closest('tr');
        row.style.opacity = '0.5';
        button.disabled = true;
        button.textContent = 'Deleting...';

        try {
          const response = await fetch(`/url/${shortId}`, {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json',
            },
          });

          const data = await response.json();

          if (response.ok && data.success) {
            // Remove the row with animation
            row.style.transition = 'opacity 0.3s ease-out';
            row.style.opacity = '0';
            setTimeout(() => {
              row.remove();
              // Reload page to update count
              window.location.reload();
            }, 300);
          } else {
            throw new Error(data.error || 'Failed to delete URL');
          }
        } catch (error) {
          console.error('Delete error:', error);
          alert('Failed to delete URL: ' + error.message);
          row.style.opacity = '1';
          button.disabled = false;
          button.textContent = 'Delete';
        }
      }

      // Update click counts automatically
      async function updateClickCounts() {
        try {
          const response = await fetch('/url/clicks');
          const data = await response.json();
          
          if (data.success && data.clickCounts) {
            // Update each click count element
            document.querySelectorAll('.click-count').forEach(element => {
              const shortId = element.getAttribute('data-short-id');
              const newCount = data.clickCounts[shortId];
              const oldCount = parseInt(element.getAttribute('data-click-count')) || 0;
              
              if (newCount !== undefined && newCount !== oldCount) {
                // Update the count with animation
                element.setAttribute('data-click-count', newCount);
                element.style.transition = 'all 0.3s ease';
                element.style.transform = 'scale(1.1)';
                element.style.backgroundColor = '#dbeafe';
                
                setTimeout(() => {
                  element.textContent = newCount + ' ' + (newCount === 1 ? 'click' : 'clicks');
                  element.style.transform = 'scale(1)';
                  setTimeout(() => {
                    element.style.backgroundColor = '';
                  }, 300);
                }, 150);
              }
            });
          }
        } catch (error) {
          console.error('Error updating click counts:', error);
        }
      }

      // Update click counts every 3 seconds
      let clickCountInterval;
      function startClickCountUpdates() {
        // Update immediately
        updateClickCounts();
        // Then update every 3 seconds
        clickCountInterval = setInterval(updateClickCounts, 3000);
      }

      // Start updating when page loads
      if (document.querySelectorAll('.click-count').length > 0) {
        startClickCountUpdates();
      }

      // Stop updating when page is hidden (to save resources)
      document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
          if (clickCountInterval) {
            clearInterval(clickCountInterval);
          }
        } else {
          if (document.querySelectorAll('.click-count').length > 0) {
            startClickCountUpdates();
          }
        }
      });

      // Form validation
      document.getElementById('urlForm')?.addEventListener('submit', function(e) {
        const urlInput = document.getElementById('url');
        const urlValue = urlInput.value.trim();
        
        if (urlValue.length === 0) {
          e.preventDefault();
          alert('Please enter a URL');
          return false;
        }
      });
    </script>
  </body>
</html>
